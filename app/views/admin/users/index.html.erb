<h1>会員一覧</h1>

<%= button_to "管理者ログアウト", destroy_admin_session_path, method: :delete, class: "btn btn-outline-secondary mb-3" %>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
  <thead>
    <tr>
      <th>ID</th>
      <th>会員名</th>
      <th>メールアドレス</th>
      <th>会員種別</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= link_to user.name, admin_user_path(user) %></td>
        <td><%= user.email %></td>
        <td><%= user.guest? ? "ゲスト" : "通常会員" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
