<h1>ClubNavi</h1>
<p>クラブのレビューを探せるサービスです。</p>

<nav>
  <%= link_to "ClubNaviについて", about_path %>
  <%= link_to "投稿一覧を見る", posts_path %>

  <% if user_signed_in? %>
    <%= link_to "マイページ", mypage_path unless current_user.guest? %>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete %>
  <% else %>
    <%= link_to "会員登録", new_user_registration_path %>
    <%= link_to "ログイン", new_user_session_path %>
        <%= button_to "ゲストとして見る", guest_sign_in_path, method: :post %>
  <% end %>
</nav>