<section class="text-center py-5">
  <p class="fw-bold mb-3">
    Club<span class="club-hero-accent">Navi</span>
  </p>

  <h1 class="display-5 fw-bold mb-4">
    <span class="club-hero-accent">音楽</span>と<span class="club-hero-accent">雰囲気</span>で、<br>
    次の<span class="club-hero-accent">Club</span>を見つけよう。
  </h1>

  <p class="fs-5 mb-5">
    Clubのレビューを探せるサービスです。
  </p>

  <div class="d-flex flex-wrap justify-content-center gap-3">
    <% if user_signed_in? %>
      <%= link_to "投稿一覧を見る", posts_path,
          class: "btn btn-primary btn-lg" %>
      <%= button_to "Log out", destroy_user_session_path,
          method: :delete,
          class: "btn btn-outline-secondary btn-lg" %>
    <% else %>
      <%= button_to "ゲストとして見る", guest_sign_in_path,
          method: :post,
          class: "btn btn-primary btn-lg" %>
      <%= link_to "Sign up", new_user_registration_path,
          class: "btn btn-outline-primary btn-lg" %>
      <%= link_to "Log in", new_user_session_path,
          class: "btn btn-outline-secondary btn-lg" %>
    <% end %>
  </div>

  <p class="mt-5">
    <%= link_to "ClubNaviについて", about_path %>
  </p>
</section>