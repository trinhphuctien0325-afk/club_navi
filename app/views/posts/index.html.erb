<h1>投稿一覧</h1>

<% if user_signed_in? && !current_user.guest? %>
  <%= link_to "新規投稿", new_post_path %>
<% end %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <h2><%= post.club.name %></h2>
      <p>投稿者：<%= post.user.name %></p>
      <p>タグ：<%= post.tag.name %></p>
      <p>評価：<%= post.rating %> / 5</p>
      <p><%= post.body %></p>
    </article>
  <% end %>
<% else %>
  <p>まだ投稿はありません。</p>
<% end %>

<%= link_to "トップへ戻る", root_path %>